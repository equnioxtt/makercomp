# Gemini API key — server-side only, never exposed to the client.
# Used by netlify/functions/generate-code.js and netlify/functions/compat-review.js
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-flash-lite-latest)
GEMINI_MODEL=

# Turso database connection (SQLite-compatible, serverless-friendly).
# Create a database with the Turso CLI: `turso db create maker-companion`
# then `turso db show maker-companion --url` and `turso db tokens create maker-companion`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local dev fallback: if TURSO_DATABASE_URL is unset, db client falls back to
# a local file DB at db/local.db (libsql embedded replica / file: URL).
# No action needed for local dev unless you want to point at real Turso.
